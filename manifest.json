{
  "manifest_version": 3,
  "name": "Audio Spectrometer",
  "version": "1.0",
  "description": "Real-time frequency spectrometer for audio playing in the current tab.",
  "permissions": [
    "tabCapture"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Audio Spectrometer"
  },
  "background": {
    "service_worker": "background.js"
  }
}